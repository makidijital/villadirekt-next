+      data: { id, is_active: true, sidebar_permissions: h.perms },
+      error: null,
+    }),
+  },
+}));
+vi.mock("next/navigation", () => ({ redirect: h.redirect }));
+vi.mock("@/app/components/admin/AdminPageSessionRefresh", () => ({
+  default: function AdminPageSessionRefresh() {
+    return null;
+  },
+}));
