+            </p>
+          )}
+        </SettingsSection>
+
+        <div className="flex justify-end">
+          <SaveButton
+            loading={saving}
+            saved={saved}
+            disabled={loading || !!loadError || urlInvalid}
+            label="Değişiklikleri kaydet"
+          />
+        </div>
+      </form>
+    </div>
+  );
+}
