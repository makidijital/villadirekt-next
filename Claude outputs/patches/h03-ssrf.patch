+): Promise<SafeGetResult> {
+  const maxRedirects = options.maxRedirects ?? 3;
+  const reqOpts = {
+    headersTimeoutMs: options.headersTimeoutMs ?? 15_000,
+    userAgent: options.userAgent ?? "TatilinYeri-Server/1.0",
